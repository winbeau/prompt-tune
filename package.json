{
  "name": "prompt-tune",
  "version": "0.1.0",
  "description": "A floating desktop companion for translating and tuning English prompts.",
  "main": "out/main/index.js",
  "author": "winbeau",
  "license": "MIT",
  "repository": "https://github.com/winbeau/prompt-tune",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "npm run build && node tests/e2e.mjs",
    "build": "npm run typecheck && electron-vite build",
    "package:mac": "npm run build && electron-builder --mac --arm64 --publish never",
    "package:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "i18next": "26.4.3",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
